---
/**
 * /fonts — THROWAWAY typography comparison page (Phase 4.5).
 *
 * Purpose: let Trevor see the two candidate type systems side by side, on the
 * real terminal-dark background, using the actual Home-page copy — before we
 * commit the whole site to one. Once a choice is made, DELETE this file.
 *
 * Why it's self-contained (no BaseLayout): BaseLayout ships the light theme and
 * the Nav/Footer chrome, which would distract from a pure type test. This page
 * defines its own <head> and styles so what you see is only the fonts.
 *
 * Fonts are pulled from Google Fonts via <link> — no npm packages installed.
 *   Option A — all monospace: JetBrains Mono everywhere.
 *   Option B — mixed: Space Grotesk (headings) + Newsreader (serif body)
 *              + Space Mono (code/prompt).
 */

// The shared sample copy, defined once so both columns render identical text.
const tagline =
  'Combat rescue flight engineer turned network builder, currently rebuilding his digital life from the ground up.';
const quote =
  'Flying rescue helicopters by day, building networks and systems by night.';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Font comparison — pick one</title>

    <!-- Google Fonts: preconnect speeds up the font fetch; the stylesheet
         pulls all four candidate families in the weights we use. -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;700&family=Newsreader:opsz,wght@6..72,400;6..72,600&family=Space+Grotesk:wght@400;500;700&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />

    <style>
      /* Terminal color tokens (from the build spec / todo.md §9). */
      :root {
        --bg: #0d1117;
        --text: #c9d1d9;
        --accent: #1cb03a;
        --muted: #8b949e;
      }

      * {
        box-sizing: border-box;
      }

      body {
        margin: 0;
        background: var(--bg);
        color: var(--text);
        padding: 2rem 1rem 4rem;
      }

      .page-title {
        max-width: 1100px;
        margin: 0 auto 2rem;
        color: var(--muted);
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.85rem;
      }

      /* Two columns side by side on wide screens, stacked on narrow. */
      .grid {
        max-width: 1100px;
        margin: 0 auto;
        display: grid;
        grid-template-columns: 1fr;
        gap: 2rem;
      }
      @media (min-width: 820px) {
        .grid {
          grid-template-columns: 1fr 1fr;
        }
      }

      .col {
        border: 1px solid #21262d;
        border-radius: 8px;
        padding: 1.75rem;
      }

      .col h2 {
        margin: 0 0 0.25rem;
        color: var(--accent);
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.95rem;
        letter-spacing: 0.02em;
      }
      .col .desc {
        margin: 0 0 1.75rem;
        color: var(--muted);
        font-family: 'JetBrains Mono', monospace;
        font-size: 0.8rem;
      }

      /* Shared structural styles for the mockup; font-family is overridden
         per option via the .opt-a / .opt-b wrappers below. */
      .prompt {
        color: var(--accent);
      }
      .name {
        font-size: 2rem;
        font-weight: 700;
        margin: 0.75rem 0 0.5rem;
      }
      .rule {
        color: var(--muted);
      }
      .roles {
        margin: 0.5rem 0;
      }
      .tagline,
      .quote {
        margin: 1rem 0;
        line-height: 1.6;
      }
      .quote {
        color: var(--muted);
      }
      .meta {
        margin-top: 1rem;
      }
      .keys {
        margin-top: 1.5rem;
        color: var(--muted);
        font-size: 0.85rem;
        line-height: 1.8;
      }
      .keys .k {
        color: var(--accent);
      }

      /* The signature blinking cursor. */
      .cursor {
        display: inline-block;
        width: 0.6ch;
        height: 1.1em;
        background: var(--accent);
        vertical-align: text-bottom;
        animation: blink 1s steps(1) infinite;
      }
      @keyframes blink {
        50% {
          opacity: 0;
        }
      }

      /* ---- Option A: everything monospace ---- */
      .opt-a {
        font-family: 'JetBrains Mono', monospace;
      }

      /* ---- Option B: mixed type system ---- */
      .opt-b {
        font-family: 'Newsreader', Georgia, serif; /* body default */
      }
      .opt-b .name,
      .opt-b .roles {
        font-family: 'Space Grotesk', sans-serif;
      }
      .opt-b .prompt,
      .opt-b .rule,
      .opt-b .keys,
      .opt-b .meta {
        font-family: 'Space Mono', monospace;
      }
      .opt-b .tagline,
      .opt-b .quote {
        font-size: 1.05rem; /* serif reads better a touch larger */
      }
    </style>
  </head>

  <body>
    <p class="page-title">
      stanferd@csar:~$ ./compare-fonts &nbsp;— throwaway page, delete after
      choosing. Resize the window to see how each holds up.
    </p>

    <div class="grid">
      <!-- ============ OPTION A — ALL MONOSPACE ============ -->
      <section class="col">
        <h2>Option A — All monospace</h2>
        <p class="desc">JetBrains Mono everywhere. Purest terminal feel.</p>

        <div class="opt-a">
          <div><span class="prompt">stanferd@csar:~$</span> whoami</div>
          <div class="name">Trevor Stevens</div>
          <div class="rule">────────────────────────</div>
          <div class="roles">Combat Rescue. Network Engineer. DevOps.</div>
          <p class="tagline">&gt; {tagline}</p>
          <p class="quote">&gt; "{quote}"</p>
          <div class="meta">📍 Arizona</div>
          <div class="keys">
            <span class="k">[a]</span> about &nbsp;
            <span class="k">[b]</span> blog &nbsp;
            <span class="k">[c]</span> career &nbsp;
            <span class="k">[x]</span> colophon<br />
            <span class="k">[d]</span> toggle dark/light &nbsp;
            <span class="k">[h]</span> help <span class="cursor"></span>
          </div>
        </div>
      </section>

      <!-- ============ OPTION B — MIXED TYPE SYSTEM ============ -->
      <section class="col">
        <h2>Option B — Mono + serif body</h2>
        <p class="desc">
          Space Grotesk headings · Newsreader body · Space Mono code.
        </p>

        <div class="opt-b">
          <div><span class="prompt">stanferd@csar:~$</span> whoami</div>
          <div class="name">Trevor Stevens</div>
          <div class="rule">────────────────────────</div>
          <div class="roles">Combat Rescue. Network Engineer. DevOps.</div>
          <p class="tagline">&gt; {tagline}</p>
          <p class="quote">&gt; "{quote}"</p>
          <div class="meta">📍 Arizona</div>
          <div class="keys">
            <span class="k">[a]</span> about &nbsp;
            <span class="k">[b]</span> blog &nbsp;
            <span class="k">[c]</span> career &nbsp;
            <span class="k">[x]</span> colophon<br />
            <span class="k">[d]</span> toggle dark/light &nbsp;
            <span class="k">[h]</span> help <span class="cursor"></span>
          </div>
        </div>
      </section>
    </div>
  </body>
</html>
