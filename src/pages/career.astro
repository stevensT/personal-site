---
/**
 * Career page (/career) — a plain bullet list grouped into Education
 * and Tech / Networking.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
// view-source easter egg (see BaseLayout `banner` prop). Edit the art in
// mount-up.txt; `?raw` imports the file as a plain string, so no escaping —
// paste any figlet font. Only rule: the art must never contain `-->`, which
// would close the HTML comment early.
import banner from '../data/mount-up.txt?raw';

// Items with `todo: true` render muted — visible reminders of details still
// to fill in.
const sections = [
  {
    heading: 'Education',
    items: [
      { text: 'B.A.S. in Network Operations — University of Arizona. Mar 2022' },
      { text: 'A.A.S. in Systems Administration / Networking (cybersecurity concentration). Mar 2019' },
    ],
  },
  {
    heading: 'Tech / Networking',
    items: [
      { text: 'Building a home lab — self-hosting services and hands-on networking.' },
      { text: 'Self-teaching full-stack web development and DevOps.' },
      { text: 'TODO: Full agentic AI development in home lab', todo: true },
      { text: 'TODO: CompTIA Network+ certification, CompTIA Security+', todo: true },
    ],
  },
];
---

<BaseLayout
  title="Career — Trevor Stevens"
  description="Trevor Stevens' career — U.S. Air Force, home-lab networking, and self-taught development."
  banner={banner}
>
  <h1 class="text-3xl font-bold">Career</h1>

  {
    sections.map((section) => (
      <section class="mt-8">
        <h2 class="font-mono text-base uppercase tracking-wide text-accent">
          {section.heading}
        </h2>
        <ul class="mt-3 space-y-2 list-disc pl-5 text-lg leading-relaxed marker:text-accent">
          {section.items.map((item) => (
            <li class={item.todo ? 'text-muted italic' : 'text-text'}>{item.text}</li>
          ))}
        </ul>
      </section>
    ))
  }
</BaseLayout>
