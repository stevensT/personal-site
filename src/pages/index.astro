---
/**
 * Home page (/) — the site's front door, built to the terminal mockup in
 * buildspec.md / todo.md §9.
 *
 * Layout (top to bottom): prompt + `whoami`, name, divider rule, role line,
 * tagline with a blinking cursor, quote, location, and the keyboard-shortcut
 * row that doubles as the primary navigation.
 *
 * The keybind row is hardcoded here for now; the Nav-rework step will extract a
 * shared component and wire the actual keydown handlers.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Prompt from '../components/Prompt.astro';
import Cursor from '../components/Cursor.astro';

// The chosen tagline + quote (see todo.md §7 "Decisions").
const tagline =
  'Combat rescue flight engineer turned network builder, currently rebuilding his digital life from the ground up.';
const quote =
  'Rescue by day, building networks and systems by night.';

// The keyboard-shortcut hints. Single source so the letters/labels stay in sync
// when the Nav rework reuses them. (Routes are wired up in a later step.)
// Page-level nav links. colophon/help live in the AppWindow footer bar instead,
// so they're intentionally omitted here. `href` is the clickable target — only
// the word itself is wrapped in the link (not the `[key]` or `~/` prefix).
const keys = [
  { key: 'a', label: 'about', href: '/about' },
  { key: 'b', label: 'blog', href: '/blog' },
  { key: 'c', label: 'career', href: '/career' },
];
---

<BaseLayout title="Trevor Stevens — Home" windowed>
  <!-- Prompt line: stanferd@csar:~$ whoami -->
  <Prompt command="whoami" />

  <!-- Name -->
  <h1 class="font-heading text-4xl font-bold mt-6 mb-2">Trevor Stevens</h1>

  <!-- Divider rule (drawn with box characters for the terminal feel) -->
  <div class="font-mono text-muted select-none" aria-hidden="true">
    ────────────────────────
  </div>

  <!--
    Role line + tagline rendered as ONE block of text: same font (Space Grotesk)
    and size, a <br /> instead of a paragraph gap, no `>` prefix. The blinking
    cursor trails the whole block.
  -->
  <p class="font-heading mt-2 leading-relaxed">
    Combat Rescue. Network Engineer. DevOps.<br />
    {tagline}<Cursor />
  </p>

  <!-- Quote -->
  <p class="mt-6 text-muted italic leading-relaxed">
    <span class="text-accent not-italic">&gt;</span> "{quote}"
  </p>

  <!--
    Primary nav, stacked vertically. Each line reads `[key] ~/word`; the [key]
    and `~/` are plain text and only the word is the link. The matching keyboard
    shortcut (wired globally in BaseLayout) still works too.
  -->
  <nav class="font-mono text-sm text-muted mt-8 flex flex-col gap-2" aria-label="Primary navigation">
    {
      keys.map((k) => (
        <span class="whitespace-nowrap">
          <span class="text-accent">[{k.key}]</span> ~/<a href={k.href} class="text-text transition-colors hover:text-accent">{k.label}</a>
        </span>
      ))
    }
  </nav>
</BaseLayout>
