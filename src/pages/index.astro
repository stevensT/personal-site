---
/**
 * Home page (/) — the site's front door, styled as a terminal session.
 *
 * Layout (top to bottom): prompt + `whoami`, name, divider rule, role line,
 * tagline with a blinking cursor, and the keyboard-shortcut row that doubles
 * as the primary navigation.
 */
import BaseLayout from '../layouts/BaseLayout.astro';

// Home nav. colophon/help live in the AppWindow footer bar, so not repeated here.
const keys = [
  { key: 'a', label: 'about', href: '/about' },
  { key: 'b', label: 'blog', href: '/blog' },
  { key: 'c', label: 'career', href: '/career' },
];
---

<BaseLayout title="Trevor Stevens — Home" windowed>
  <!-- Prompt line: stanferd@csar:~$ whoami (`csar` = combat search-and-rescue) -->
  <span class="font-mono text-sm">
    <span class="text-accent">stanferd@csar:~$</span>
    <span class="text-text"> whoami</span>
  </span>

  <h1 class="font-heading text-4xl font-bold mt-6 mb-2">Trevor Stevens</h1>

  <!-- Divider rule (drawn with box characters for the terminal feel) -->
  <div class="font-mono text-muted select-none" aria-hidden="true">
    ────────────────────────
  </div>

  <!-- Role line + tagline as one block, <br /> not a paragraph gap; cursor trails it. -->
  <p class="font-heading mt-2 leading-relaxed">
    Combat Rescue. Network Engineer. DevOps.<br />
    Combat rescue flight engineer turned network builder, currently rebuilding
    his digital life from the ground up.<span class="cursor" aria-hidden="true"></span>
  </p>

  <!-- Only the word is the link; the [key] shortcuts themselves are wired in BaseLayout. -->
  <nav class="font-mono text-sm text-muted mt-8 flex flex-col gap-2" aria-label="Primary navigation">
    {
      keys.map((k) => (
        <span class="whitespace-nowrap">
          <span class="text-accent">[{k.key}]</span> ~/<a href={k.href} class="text-text transition-colors hover:text-accent">{k.label}</a>
        </span>
      ))
    }
  </nav>
</BaseLayout>
