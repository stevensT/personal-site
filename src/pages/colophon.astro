---
/**
 * Colophon page (/colophon) — how the site is built and the design choices
 * behind it, per buildspec.md. Content is factual about this project's stack,
 * so it's written out in full (no placeholders).
 */
import BaseLayout from '../layouts/BaseLayout.astro';

// The build stack, shown as a simple labelled list.
const stack = [
  { label: 'Framework', value: 'Astro (static output — ships zero JS by default)' },
  { label: 'Styling', value: 'Tailwind CSS v4 (design tokens via @theme)' },
  { label: 'Language', value: 'TypeScript (strict mode)' },
  { label: 'Hosting', value: 'Cloudflare Pages, deployed from GitHub' },
  { label: 'Editor', value: 'VS Code' },
];

// The deliberate design decisions worth calling out.
const choices = [
  'A terminal / CLI aesthetic — the constraint is the personality.',
  'Dark by default, with a [d] toggle to a light theme (your choice is remembered).',
  'Keyboard-driven navigation: [a] about, [b] blog, [c] career, [x] colophon, [h] help.',
  'Type system: Space Grotesk for headings, Newsreader for body, Space Mono for code.',
  'The home page lives inside an "app window"; inner pages stay plain and quiet.',
  'A blinking cursor after the tagline — the signature touch.',
];
---

<BaseLayout
  title="Colophon — Trevor Stevens"
  description="How this site is built: Astro, Tailwind CSS, TypeScript, hosted on Cloudflare Pages — and the design choices behind its terminal aesthetic."
>
  <h1 class="text-3xl font-bold">Colophon</h1>

  <p class="mt-6 text-text text-lg leading-relaxed">
    A quick note on how this site is put together and why it looks the way it does.
  </p>

  <section class="mt-8">
    <h2 class="font-mono text-sm uppercase tracking-wide text-accent">Built with</h2>
    <ul class="mt-3 space-y-2 text-lg leading-relaxed">
      {
        stack.map((item) => (
          <li class="text-text">
            <span class="text-muted">{item.label}:</span> {item.value}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mt-8">
    <h2 class="font-mono text-sm uppercase tracking-wide text-accent">Design choices</h2>
    <ul class="mt-3 space-y-2 list-disc pl-5 text-lg leading-relaxed text-text marker:text-accent">
      {choices.map((choice) => <li>{choice}</li>)}
    </ul>
  </section>
</BaseLayout>
