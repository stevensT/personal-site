---
/**
 * BaseLayout — the shared shell wrapped around every page.
 *
 * Supplies the <head> (charset, viewport, favicon, SEO title/description) and
 * the persistent site chrome (Nav + Footer), so each page only provides its
 * own unique body content via <slot />.
 *
 * WHY global.css is imported here: this single import is what makes Tailwind's
 * utility classes available on every page. Importing it once in the layout
 * (rather than per-page) means Tailwind is wired site-wide from one place.
 *
 * Props:
 *   - title:        string  — text for the browser tab / <title> (required)
 *   - description?: string  — meta description for SEO (optional; has a default)
 */
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

// Fallback description used when a page does not pass its own.
const {
  title,
  description = 'Personal site of Trevor Stevens — learning to code, AI/LLMs, and DevOps in public.',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <!--
    min-h-screen + flex flex-col + a flex-1 <main> gives a "sticky footer":
    the footer sits at the bottom even on short pages.
  -->
  <body class="min-h-screen flex flex-col bg-white text-gray-900">
    <Nav />
    <!-- Each page's unique content is injected here. max-w keeps lines readable. -->
    <main class="flex-1 w-full max-w-3xl mx-auto px-4 py-10">
      <slot />
    </main>
    <Footer />
  </body>
</html>
