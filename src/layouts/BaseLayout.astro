---
/**
 * BaseLayout — the shared shell around every page: <head>, site chrome, and
 * the keyboard-nav / theme-toggle / help-overlay scripts at the bottom.
 *
 * global.css is imported here (and only here) so Tailwind applies site-wide.
 *
 * Props:
 *   - title:        browser tab / <title>
 *   - description?: meta description (has a default)
 *   - windowed?:    home only — wraps content in the AppWindow chrome instead
 *                   of the plain Nav/Footer column (default false)
 */
import '../styles/global.css';
import AppWindow from '../components/AppWindow.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
  windowed?: boolean;
}

const {
  title,
  description = 'Personal site of Trevor Stevens — learning to code, AI/LLMs, and DevOps in public.',
  windowed = false,
} = Astro.props;

// Absolute canonical URL — crawlers and social embeds want absolute, not relative.
// Astro.site comes from astro.config.mjs.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>

    <!-- Browser UI color on mobile (address bar). Matches the dark page bg. -->
    <meta name="theme-color" content="#0d1117" />

    <!--
      Open Graph — how links look when shared (Slack, iMessage, X, etc.).
      og:image omitted until a social-preview image exists.
    -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Trevor Stevens" />
    <!-- twitter:title/description omitted — X falls back to the og: tags above. -->
    <meta name="twitter:card" content="summary" />

    <!--
      Space Grotesk — headings · Newsreader — body · Space Mono — prompt/code.
      preconnect warms the connection; display=swap shows a fallback immediately
      and swaps the web font in when it arrives.
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,600&family=Space+Grotesk:wght@400;500;700&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />

    <!--
      Anti-flash theme script. is:inline so it runs before the body paints —
      a light-mode visitor never sees a dark flash. Dark is the default, so
      only act when 'light' is saved.
    -->
    <script is:inline>
      if (localStorage.getItem("theme") === "light") {
        document.documentElement.dataset.theme = "light";
      }
    </script>
  </head>
  <!-- The body is the dark "desktop"; home floats an AppWindow on it, the rest
       get a plain centered column. -->
  <body class="min-h-screen bg-page text-text font-body">
    {
      windowed ? (
        <main class="flex min-h-screen w-full flex-col items-center justify-center p-4 sm:p-8">
          <AppWindow>
            <slot />
          </AppWindow>
        </main>
      ) : (
        <div class="flex min-h-screen flex-col">
          <Nav />
          <main class="mx-auto w-full max-w-[700px] flex-1 px-4 py-10 sm:py-16">
            <slot />
          </main>
          <Footer />
        </div>
      )
    }

    <!-- Help overlay, shown/hidden by [h]. `hidden` keeps it out of the layout
         and the accessibility tree until then. -->
    <div
      id="help-overlay"
      hidden
      class="fixed inset-0 z-50 flex items-center justify-center bg-black/70 p-4"
    >
      <div
        class="w-full max-w-xs rounded-lg border border-line bg-elevated p-6 font-mono text-sm"
      >
        <p class="mb-3 text-accent">keyboard shortcuts</p>
        <ul class="space-y-1 text-muted">
          <li><span class="text-accent">[a]</span> about</li>
          <li><span class="text-accent">[b]</span> blog</li>
          <li><span class="text-accent">[c]</span> career</li>
          <li><span class="text-accent">[x]</span> colophon</li>
          <li><span class="text-accent">[d]</span> toggle dark / light</li>
          <li><span class="text-accent">[h]</span> toggle this help</li>
          <li><span class="text-accent">[esc]</span> close</li>
        </ul>
      </div>
    </div>

    <!-- Site-wide keyboard nav + theme toggle. Runs once per page load; since
         every navigation is a full page load, re-binding each time is fine. -->
    <script>
      // key -> path. d/h/esc are handled specially below.
      const ROUTES: Record<string, string> = {
        a: "/about",
        b: "/blog",
        c: "/career",
        x: "/colophon",
      };

      const html = document.documentElement;
      const helpOverlay = document.getElementById("help-overlay");

      /**
       * Flip dark <-> light and remember the choice. The CSS keys off the
       * data-theme attribute: present = light, absent = dark (the default).
       */
      function toggleTheme(): void {
        const next = html.dataset.theme === "light" ? "dark" : "light";
        localStorage.setItem("theme", next);
        if (next === "light") html.dataset.theme = "light";
        else delete html.dataset.theme;
      }

      /** Show/hide the keyboard-shortcut overlay. */
      function toggleHelp(force?: boolean): void {
        if (!helpOverlay) return;
        const show = force ?? helpOverlay.hasAttribute("hidden");
        helpOverlay.toggleAttribute("hidden", !show);
      }

      // The title-bar sun icon mirrors the [d] shortcut.
      document
        .getElementById("theme-toggle")
        ?.addEventListener("click", toggleTheme);

      // Clicking the dimmed backdrop (but not the panel) closes help.
      helpOverlay?.addEventListener("click", (e) => {
        if (e.target === helpOverlay) toggleHelp(false);
      });

      document.addEventListener("keydown", (e) => {
        // Don't hijack browser/OS shortcuts (Ctrl/Cmd/Alt combos).
        if (e.metaKey || e.ctrlKey || e.altKey) return;

        // Don't fire while the user is typing in a field.
        const el = e.target as HTMLElement | null;
        if (
          el &&
          (el.tagName === "INPUT" ||
            el.tagName === "TEXTAREA" ||
            el.isContentEditable)
        ) {
          return;
        }

        if (e.key === "Escape") {
          toggleHelp(false);
          return;
        }

        const key = e.key.toLowerCase();
        if (key === "d") {
          toggleTheme();
        } else if (key === "h") {
          toggleHelp();
        } else if (ROUTES[key]) {
          window.location.href = ROUTES[key];
        }
      });
    </script>
  </body>
</html>
