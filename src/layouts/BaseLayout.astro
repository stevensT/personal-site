---
/**
 * BaseLayout — the shared shell around every page: <head>, site chrome, and
 * the native Help dialog and shared site-controls script.
 *
 * global.css is imported here (and only here) so Tailwind applies site-wide.
 *
 * Props:
 *   - title:        browser tab / <title>
 *   - description?: meta description (has a default)
 *   - windowed?:    home only — wraps content in the AppWindow chrome instead
 *                   of the plain Nav/Footer column (default false)
 *   - banner?:      ASCII art dropped into an HTML comment at the top of
 *                   <head> — an easter egg for anyone who reads view-source.
 *                   Per-page override; falls back to DEFAULT_BANNER.
 */
import '../styles/global.css';
import AppWindow from '../components/AppWindow.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ShortcutHelp from '../components/ShortcutHelp.astro';

// Injected raw (set:html) into an HTML comment, so any banner MUST NOT contain
// `-->` or a stray `--` — it would break out of the comment. All callers pass
// author-controlled literals, so this is a convention, not a runtime guard.
const DEFAULT_BANNER = `
  ┌─[ stanferd.dev ]
  └─$ you found the source. poke around.
`;

interface Props {
  title: string;
  description?: string;
  windowed?: boolean;
  banner?: string;
}

const {
  title,
  description = 'Personal site of Trevor Stevens — learning to code, AI/LLMs, and DevOps in public.',
  windowed = false,
  banner = DEFAULT_BANNER,
} = Astro.props;

// Absolute canonical URL — crawlers and social embeds want absolute, not relative.
// Astro.site comes from astro.config.mjs.
const canonical = new URL(Astro.url.pathname, Astro.site).href;
---

<!doctype html>
<html lang="en">
  <head>
    <!-- view-source easter egg; set:html keeps the comment raw (see DEFAULT_BANNER). -->
    <Fragment set:html={`<!--${banner}-->`} />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!-- humanstxt.org convention: points at the /humans.txt easter egg. -->
    <link rel="author" type="text/plain" href="/humans.txt" />
    <title>{title}</title>

    <!-- Browser UI color on mobile (address bar). Matches the dark page bg. -->
    <meta name="theme-color" content="#0d1117" />

    <!--
      Open Graph — how links look when shared (Slack, iMessage, X, etc.).
      og:image omitted until a social-preview image exists.
    -->
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Trevor Stevens" />
    <!-- twitter:title/description omitted — X falls back to the og: tags above. -->
    <meta name="twitter:card" content="summary" />

    <!--
      Space Grotesk — headings · Newsreader — body · Space Mono — prompt/code.
      preconnect warms the connection; display=swap shows a fallback immediately
      and swaps the web font in when it arrives.
    -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Newsreader:opsz,wght@6..72,400;6..72,600&family=Space+Grotesk:wght@400;500;700&family=Space+Mono:wght@400;700&display=swap"
      rel="stylesheet"
    />

    <!--
      Anti-flash theme script. is:inline so it runs before the body paints —
      a light-mode visitor never sees a dark flash. Dark is the default, so
      only act when 'light' is saved.
    -->
    <script is:inline data-theme-init>
      try {
        if (localStorage.getItem("theme") === "light") {
          document.documentElement.dataset.theme = "light";
        }
      } catch {
        // Storage can be blocked; retain the default theme and usable controls.
      }
    </script>

    <!-- DevTools easter egg. is:inline so it ships verbatim, styled like the prompt. -->
    <script is:inline>
      console.log(
        "%c$ whoami\n> you found the console. hi.",
        'color:#1cb03a;font:14px "Space Mono",monospace',
      );
    </script>
  </head>
  <!-- The body is the dark "desktop"; home floats an AppWindow on it, the rest
       get a plain centered column. -->
  <body class="min-h-screen bg-page text-text font-body">
    {
      windowed ? (
        <main class="flex min-h-screen w-full flex-col items-center justify-center p-4 sm:p-8">
          <AppWindow>
            <slot />
          </AppWindow>
        </main>
      ) : (
        <div class="flex min-h-screen flex-col">
          <Nav />
          <main class="mx-auto w-full max-w-[700px] flex-1 px-4 py-10 sm:py-16">
            <slot />
          </main>
          <Footer />
        </div>
      )
    }

    <ShortcutHelp />
    <script>
      import '../scripts/site-controls';
    </script>
  </body>
</html>
