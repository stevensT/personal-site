---
/**
 * BlogLayout — shell for a single post: BaseLayout chrome + post header
 * (title, date, tags) + the Markdown body in a `.post-body` wrapper that
 * global.css styles like an article.
 *
 * Props:
 *   - post: the blog collection entry; its rendered body comes in via <slot />
 */
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, date, tags } = post.data;

// timeZone: 'UTC' or the date shows a day early — a bare YAML date parses as
// UTC midnight, and we're west of UTC.
const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<BaseLayout title={`${title} — Trevor Stevens`} description={description}>
  <article>
    <h1 class="text-3xl font-bold">{title}</h1>
    <p class="mt-2 font-mono text-sm text-muted">
      <time datetime={date.toISOString()}>{formattedDate}</time>
      {tags.length > 0 && <span> · {tags.join(', ')}</span>}
    </p>

    <!-- Rendered Markdown lands here; .post-body (global.css) styles it. -->
    <div class="post-body mt-8 text-lg text-text">
      <slot />
    </div>
  </article>
</BaseLayout>
