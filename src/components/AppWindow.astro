---
/**
 * AppWindow — a macOS-style "app window" shell wrapped around page content.
 *
 * Renders three parts:
 *   1. Title bar  — traffic-light dots, the centered domain title, a theme-
 *                   toggle icon (wired up in the keyboard-nav step).
 *   2. Body       — the page's content, injected via <slot />.
 *   3. Footer bar — location on the left, colophon/help keybinds on the right.
 *
 * Used by BaseLayout so every page sits inside the same window chrome.
 *
 * Props:
 *   - windowTitle?: string — text centered in the title bar (default the domain).
 *   - location?:    string — place shown in the footer bar (default "Arizona").
 */
interface Props {
  windowTitle?: string;
  location?: string;
}

const { windowTitle = 'stanferd.dev', location = 'Arizona' } = Astro.props;

// Build-time copyright year for the footer bar.
const year = new Date().getFullYear();

// Keybind hints shown in the footer bar (the global ones, vs. the page-level
// nav keys on the home body). Letters in accent green via the template below.
const footerKeys = [
  { key: 'x', label: 'colophon' },
  { key: 'h', label: 'help' },
];

// External profile links shown inside the window. Label-only (no @username) —
// the handle lives in the href. rel="me" marks these as Trevor's own profiles.
const socials = [
  { label: 'github', href: 'https://github.com/stevensT' },
  { label: 'instagram', href: 'https://instagram.com/stevenstrevor' },
];
---

<div
  class="mx-auto w-full max-w-[720px] overflow-hidden rounded-xl border border-line bg-bg shadow-2xl"
>
  <!-- ===== Title bar ===== -->
  <div
    class="flex items-center gap-4 border-b border-line bg-elevated px-4 py-3"
  >
    <!-- Traffic-light dots (decorative) -->
    <div class="flex gap-2" aria-hidden="true">
      <span class="h-3 w-3 rounded-full bg-[#ff5f56]"></span>
      <span class="h-3 w-3 rounded-full bg-[#ffbd2e]"></span>
      <span class="h-3 w-3 rounded-full bg-[#27c93f]"></span>
    </div>

    <!-- Centered window title (the domain) -->
    <span class="flex-1 text-center font-mono text-sm text-muted">
      {windowTitle}
    </span>

    <!--
      Theme toggle. Non-functional for now — the keyboard-nav step wires it to
      [d] and persists the choice. id is the hook for that script.
    -->
    <button
      id="theme-toggle"
      type="button"
      aria-label="Toggle light/dark theme"
      class="text-muted transition-colors hover:text-accent"
    >
      <!-- Simple sun glyph -->
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="12" cy="12" r="4"></circle>
        <path
          d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
        ></path>
      </svg>
    </button>
  </div>

  <!-- ===== Body ===== -->
  <div class="px-6 py-8 sm:px-8">
    <slot />

    <!-- Social profile links (global). Label-only; href carries the handle. -->
    <nav class="mt-8 flex gap-6 font-mono text-sm text-muted" aria-label="Social links">
      {
        socials.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="me noopener noreferrer"
            class="transition-colors hover:text-accent"
          >
            {s.label}
          </a>
        ))
      }
    </nav>
  </div>

  <!-- ===== Footer bar ===== -->
  <div
    class="flex items-center justify-between gap-4 border-t border-line bg-elevated px-4 py-3 font-mono text-sm text-muted"
  >
    <span class="flex gap-4">
      <span>📍 {location}</span>
      <span>© {year} Trevor Stevens</span>
    </span>
    <span class="flex gap-4">
      {
        footerKeys.map((k) => (
          <span class="whitespace-nowrap">
            <span class="text-accent">[{k.key}]</span> {k.label}
          </span>
        ))
      }
    </span>
  </div>
</div>
