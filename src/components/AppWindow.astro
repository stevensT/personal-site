---
/**
 * AppWindow — the macOS-style "app window" shell around the home page:
 * title bar (traffic lights, domain, theme toggle), body via <slot />,
 * and a footer bar (copyright/location left, colophon/help keybinds right).
 *
 * No props.
 */
// Baked in at build time; refreshes on each deploy.
const year = new Date().getFullYear();

// Footer-bar keybinds. `help` has no href — [h] toggles the overlay — so it
// stays plain text.
const footerKeys = [
  { key: 'x', label: 'colophon', href: '/colophon' },
  { key: 'h', label: 'help' },
];

// Label-only; the handle lives in the href. rel="me" = these are my profiles.
const socials = [
  { label: 'github', href: 'https://github.com/stevensT' },
  { label: 'instagram', href: 'https://instagram.com/stevenstrevor' },
];
---

<div
  class="mx-auto w-full max-w-[720px] overflow-hidden rounded-xl border border-line bg-bg shadow-2xl"
>
  <!-- ===== Title bar ===== -->
  <div
    class="flex items-center gap-4 border-b border-line bg-elevated px-4 py-3"
  >
    <!-- Traffic-light dots (decorative) -->
    <div class="flex gap-2" aria-hidden="true">
      <span class="h-3 w-3 rounded-full bg-[#ff5f56]"></span>
      <span class="h-3 w-3 rounded-full bg-[#ffbd2e]"></span>
      <span class="h-3 w-3 rounded-full bg-[#27c93f]"></span>
    </div>

    <!-- Centered window title (the domain) -->
    <span class="flex-1 text-center font-mono text-sm text-muted">
      stanferd.dev
    </span>

    <!-- Theme toggle — mirrors [d]. BaseLayout's script hooks this id. -->
    <button
      id="theme-toggle"
      type="button"
      aria-label="Toggle light/dark theme"
      class="text-muted transition-colors hover:text-accent"
    >
      <!-- Simple sun glyph -->
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="18"
        height="18"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <circle cx="12" cy="12" r="4"></circle>
        <path
          d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M6.34 17.66l-1.41 1.41M19.07 4.93l-1.41 1.41"
        ></path>
      </svg>
    </button>
  </div>

  <!-- ===== Body ===== -->
  <div class="px-6 py-8 sm:px-8">
    <slot />

    <nav class="mt-8 flex gap-6 font-mono text-sm text-muted" aria-label="Social links">
      {
        socials.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="me noopener noreferrer"
            class="transition-colors hover:text-accent"
          >
            {s.label}
          </a>
        ))
      }
    </nav>
  </div>

  <!-- ===== Footer bar ===== -->
  <div
    class="flex flex-wrap items-center justify-between gap-x-4 gap-y-2 border-t border-line bg-elevated px-4 py-3 font-mono text-sm text-muted"
  >
    <span class="flex flex-wrap gap-x-4 gap-y-1">
      <span>© {year} Trevor Stevens</span>
      <span>📍 Tucson, AZ 🌵</span>
    </span>
    <span class="flex flex-wrap gap-x-4 gap-y-1">
      {
        footerKeys.map((k) => (
          <span class="whitespace-nowrap">
            <span class="text-accent">[{k.key}]</span>{' '}
            {k.href ? (
              <a href={k.href} class="transition-colors hover:text-accent">
                {k.label}
              </a>
            ) : (
              k.label
            )}
          </span>
        ))
      }
    </span>
  </div>
</div>
