---
/**
 * Footer — site-wide footer, rendered at the bottom of every page by BaseLayout.
 *
 * Shows the current year and contact info (Instagram). This is where contact
 * lives — there is no separate Contact page by design.
 *
 * No props.
 */

// Computed once at build time. WHY this works without client-side JS: Astro runs
// this frontmatter when the site is built, so the year is baked into the HTML.
// It updates whenever the site is rebuilt (e.g. on each deploy).
const year = new Date().getFullYear();
---

<footer class="border-t border-line">
  <div
    class="max-w-[700px] mx-auto px-4 py-6 flex justify-between text-sm text-muted font-mono"
  >
    <span>© {year} Trevor Stevens</span>
    <!--
      External link: target=_blank opens a new tab; rel="me" declares this as
      Trevor's own profile (identity); noopener/noreferrer are security hygiene
      for any new-tab external link.
    -->
    <a
      href="https://instagram.com/stevenstrevor"
      target="_blank"
      rel="me noopener noreferrer"
      class="hover:text-accent"
    >
      Instagram @stevenstrevor
    </a>
  </div>
</footer>
