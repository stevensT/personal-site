---
/**
 * Footer — the normal site footer for non-home pages (Home uses the AppWindow
 * footer bar instead). Shows copyright and Trevor's social profile links.
 *
 * No props.
 */

// Computed once at build time. WHY this works without client-side JS: Astro runs
// this frontmatter when the site is built, so the year is baked into the HTML.
// It updates whenever the site is rebuilt (e.g. on each deploy).
const year = new Date().getFullYear();

// Label-only social links (handle lives in the href), matching the home window.
const socials = [
  { label: 'github', href: 'https://github.com/stevensT' },
  { label: 'instagram', href: 'https://instagram.com/stevenstrevor' },
];
---

<footer>
  <!-- Divider is on the inner container so the line is content-width, not full page. -->
  <div
    class="max-w-[700px] mx-auto px-4 py-6 flex flex-wrap justify-between gap-x-4 gap-y-2 text-sm text-muted font-mono border-t border-line"
  >
    <span class="flex flex-wrap gap-x-3 gap-y-1">
      <span>© {year} Trevor Stevens</span>
      <span>📍 Tucson, AZ 🌵</span>
    </span>
    <!--
      External links: target=_blank opens a new tab; rel="me" declares these as
      Trevor's own profiles (identity); noopener/noreferrer are security hygiene
      for any new-tab external link.
    -->
    <nav class="flex gap-4" aria-label="Social links">
      {
        socials.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="me noopener noreferrer"
            class="transition-colors hover:text-accent"
          >
            {s.label}
          </a>
        ))
      }
    </nav>
  </div>
</footer>
