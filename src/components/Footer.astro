---
/**
 * Footer — for the non-home pages (home uses the AppWindow footer bar).
 * Copyright, location, and social links. No props.
 */

// Baked in at build time; refreshes on each deploy.
const year = new Date().getFullYear();

// Label-only; the handle lives in the href. Matches the home window's list.
const socials = [
  { label: 'github', href: 'https://github.com/stevensT' },
  { label: 'instagram', href: 'https://instagram.com/stevenstrevor' },
];
---

<footer>
  <!-- Border on the inner container so the divider is content-width, not full page. -->
  <div
    class="max-w-[700px] mx-auto px-4 py-6 flex flex-wrap justify-between gap-x-4 gap-y-2 text-sm text-muted font-mono border-t border-line"
  >
    <span class="flex flex-wrap gap-x-3 gap-y-1">
      <span>© {year} Trevor Stevens</span>
      <span>📍 Tucson, AZ 🌵</span>
    </span>
    <!-- rel="me" = these are my profiles; noopener/noreferrer is standard
         hygiene for target=_blank links. -->
    <nav class="flex gap-4" aria-label="Social links">
      {
        socials.map((s) => (
          <a
            href={s.href}
            target="_blank"
            rel="me noopener noreferrer"
            class="transition-colors hover:text-accent"
          >
            {s.label}
          </a>
        ))
      }
    </nav>
  </div>
</footer>
