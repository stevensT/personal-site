---
/**
 * Nav — primary site navigation, rendered at the top of every page by BaseLayout.
 *
 * Links to all five planned top-level pages. Pages not yet built (About,
 * Projects, Blog, Contact) will 404 until they are added in later phases —
 * that is expected during construction.
 *
 * No props.
 */

// Single source of truth for the nav links. Adding a page later = adding one
// entry here, rather than editing markup in several places.
const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/projects', label: 'Projects' },
  { href: '/blog', label: 'Blog' },
  { href: '/contact', label: 'Contact' },
];
---

<header class="border-b border-gray-200">
  <nav class="max-w-3xl mx-auto px-4 py-4 flex items-center justify-between">
    <a href="/" class="font-bold text-lg">Trevor Stevens</a>
    <ul class="flex gap-4 text-sm">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class="text-gray-600 hover:text-gray-900">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
