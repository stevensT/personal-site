---
/**
 * Nav — top nav for the non-home pages (home uses the AppWindow keybind nav).
 * No Contact page on purpose; contact lives in the Footer. No props.
 */

// Home is the prompt link on the left, and colophon is deliberately home-only
// ([x] / footer bar), so neither appears here.
const links = [
  { href: '/about', label: 'About' },
  { href: '/career', label: 'Career' },
  { href: '/blog', label: 'Blog' },
];
---

<header>
  <nav class="max-w-[700px] mx-auto px-4 py-4 flex items-center justify-between">
    <!-- Terminal-style link back home, instead of a plain name/brand. -->
    <a
      href="/"
      class="font-mono text-sm text-muted transition-colors hover:text-accent"
    >
      <span class="text-accent">stanferd@csar:~$</span> cd ~
    </a>
    <ul class="flex gap-4 text-sm font-mono">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class="text-muted hover:text-accent">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
