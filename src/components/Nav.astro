---
/**
 * Nav — primary site navigation, rendered at the top of every page by BaseLayout.
 *
 * Links to the top-level pages. Blog is not built until Phase 5, so it will 404
 * until then — expected during construction. There is no Contact page by design;
 * contact info lives in the Footer instead.
 *
 * No props.
 */

// Single source of truth for the nav links. Adding a page later = adding one
// entry here, rather than editing markup in several places.
const links = [
  { href: '/', label: 'Home' },
  { href: '/about', label: 'About' },
  { href: '/projects', label: 'Projects' },
  { href: '/blog', label: 'Blog' },
];
---

<header class="border-b border-line">
  <nav class="max-w-[700px] mx-auto px-4 py-4 flex items-center justify-between">
    <a href="/" class="font-heading font-bold text-lg text-text">Trevor Stevens</a>
    <ul class="flex gap-4 text-sm font-mono">
      {
        links.map((link) => (
          <li>
            <a href={link.href} class="text-muted hover:text-accent">
              {link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
</header>
