---
/**
 * PostCard — preview tile shared by the blog index and tag archives.
 * Article title and tags are separate links so anchors never nest.
 *
 * Props:
 *   - post: a blog collection entry (frontmatter in `post.data`)
 */
import type { CollectionEntry } from 'astro:content';
import { tagSlug } from '../utils/tags';

interface Props {
  post: CollectionEntry<'blog'>;
}

const { post } = Astro.props;
const { title, description, date, tags } = post.data;

// timeZone: 'UTC' or the date shows a day early — a bare YAML date parses as
// UTC midnight, and we're west of UTC.
const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
  timeZone: 'UTC',
});
---

<article class="post-card rounded-lg border border-line p-5">
  <p class="font-mono text-xs text-muted">
    <time datetime={date.toISOString()}>{formattedDate}</time>
  </p>
  <h2 class="mt-1 font-heading text-xl font-bold text-text">
    <a href={`/blog/${post.id}`} class="hover:text-accent hover:underline focus-visible:underline">{title}</a>
  </h2>
  <p class="mt-2 leading-relaxed text-muted">{description}</p>
  {tags.length > 0 && (
    <ul class="mt-3 flex flex-wrap gap-x-3 gap-y-1 font-mono text-xs text-muted" role="list" aria-label="Tags">
      {tags.map((tag) => (
        <li><a href={`/tags/${tagSlug(tag)}/`} class="inline-block py-1 hover:text-accent hover:underline focus-visible:underline">{tag}</a></li>
      ))}
    </ul>
  )}
</article>
